@model IEnumerable<VoluntraGProject.Models.NGO>

@{
    ViewData["Title"] = "Index";
}

<h1 class="page-title">NGO List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.NGOName)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.DetailedDescription)</th>
            <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
            <th>@Html.DisplayNameFor(model => model.Address)</th>
            <th>@Html.DisplayNameFor(model => model.Type)</th>
            <th>@Html.DisplayNameFor(model => model.Image)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NGOName)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.DetailedDescription)</td>
                <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                <td>@Html.DisplayFor(modelItem => item.Type)</td>
                <td>
                    <img src="@item.Image" alt="NGO Image" class="img-fluid ngo-image" />
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.NGOId" class="btn btn-warning btn-sm">Edit</a> 
                    <a asp-action="Details" asp-route-id="@item.NGOId" class="btn btn-info btn-sm">Details</a> 
                    <a asp-action="Delete" asp-route-id="@item.NGOId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .page-title {
        text-align: center;
        margin-bottom: 30px;
        font-size: 2rem;
        color: #4CAF50;
    }

    .table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 12px;
            text-align: left;
            border: 1px solid #ddd;
        }

    .table-striped tbody tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    .table th {
        background-color: #4CAF50;
        color: white;
        text-align: center;
    }

    .btn {
        padding: 8px 16px;
        text-decoration: none;
        margin: 3px;
        border-radius: 5px;
        color: white;
        font-size: 1rem;
        display: inline-block;
        line-height: 1.5;
        text-align: center;
    }

    .btn-primary {
        background-color: #007bff;
    }

    .btn-warning {
        background-color: #ffc107;
    }

    .btn-info {
        background-color: #17a2b8;
    }

    .btn-danger {
        background-color: #dc3545;
    }

    .btn-sm {
        font-size: 0.875rem;
        padding: 5px 10px;
    }

    .img-fluid {
        max-width: 100%;
        height: auto;
    }

    .ngo-image {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 50%;
    }

    .btn:hover {
        opacity: 0.8;
    }

    td a {
        margin: 0 5px;
    }
</style>
