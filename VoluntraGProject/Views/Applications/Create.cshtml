@model VoluntraGProject.Models.Application


@{
    ViewData["Title"] = "Event Applying";
}

<body>
    <!-- Page Header Start -->
    <div class="page-header">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h2>Application</h2>
                </div>
                <div class="col-12">
                    <a href="">Event</a>
                    <a href="">Appying</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header End -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- Single Post Start-->
    <div class="single">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="comment-form">
                        <h2>Apply to the event</h2>
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div type="hidden">
                                <input type="hidden" asp-for="EventId" value="@ViewBag.eventid" />
                                <span asp-validation-for="EventId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="VolunteerName" class="control-label">Enter Your Name *</label>
                                <input asp-for="VolunteerName" type="text" class="form-control" id="name">
                                <span asp-validation-for="VolunteerName" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Email" class="control-label">Your Email *</label>
                                <input asp-for="Email" type="email" class="form-control" id="email">
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="skills" class="control-label">Your Skills *</label>
                                <input asp-for="skills" type="text" class="form-control" id="website">
                                <span asp-validation-for="skills" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Experience" class="control-label">Your Experience *</label>
                                <textarea asp-for="Experience" id="message" cols="30" rows="5" class="form-control"></textarea>
                                <span asp-validation-for="Experience" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="AppliedDate" class="control-label"></label>
                                <input id="AppliedDate" asp-for="AppliedDate" class="form-control" />
                                <span asp-validation-for="AppliedDate" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Age" class="control-label"></label>
                                <input asp-for="Age" class="form-control" />
                                <span asp-validation-for="Age" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="YearsOfExperience" class="control-label"></label>
                                <input asp-for="YearsOfExperience" class="form-control" />
                                <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Yourfield" class="control-label"></label>
                                <select asp-for="Yourfield" class="form-control">
                                    <option value="">-- Select an option --</option>
                                    <option value="Arts and Culture">Arts and Culture</option>
                                    <option value="Education">Education</option>
                                    <option value="Empowerment">Empowerment</option>
                                    <option value="Environment">Environment</option>
                                    <option value="Health Care">Health Care</option>
                                    <option value="Community">Community</option>
                                </select>
                                <span asp-validation-for="Yourfield" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>@Html.DisplayNameFor(model => model.IsExpereinced)</label>
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" asp-for="IsExpereinced" value="true" id="yesOption" />
                                    <label class="form-check-label" for="yesOption">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" asp-for="IsExpereinced" value="false" id="noOption" />
                                    <label class="form-check-label" for="noOption">No</label>
                                </div>
                                <span asp-validation-for="IsExpereinced" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Location" class="control-label"></label>
                                <select asp-for="Location" class="form-control">
                                    <option value="">-- Select a Country --</option>
                                    <option value="UK">UK</option>
                                    <option value="Egypt">Egypt</option>
                                    <option value="Lebanon">Lebanon</option>
                                    <option value="India">India</option>
                                    <option value="USA">USA</option>
                                    <option value="KSA">KSA</option>
                                    <option value="Jordan">Jordan</option>
                                    <option value="Africa">Africa</option>
                                    <option value="Palestine">Palestine</option>
                                    <option value="Syria">Syria</option>
                                    <option value="Turkey">Turkey</option>
                                </select>
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label>@Html.DisplayNameFor(model => model.TravelingAbility)</label>
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" asp-for="TravelingAbility" value="true" id="travelYes" />
                                    <label class="form-check-label" for="travelYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" asp-for="TravelingAbility" value="false" id="travelNo" />
                                    <label class="form-check-label" for="travelNo">No</label>
                                </div>
                                <span asp-validation-for="TravelingAbility" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <input type="submit" id="submitButton" name="Apply Now" value="Create" class="btn btn-custom">
                            </div>
                        </form>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="sidebar">

                        <div class="sidebar-widget">
                            <h2 class="widget-title">Tags Cloud</h2>
                            <div class="tag-widget">
                                <a href="">National</a>
                                <a href="">International</a>
                                <a href="">Economics</a>
                                <a href="">Politics</a>
                                <a href="">Lifestyle</a>
                                <a href="">Technology</a>
                                <a href="">Trades</a>
                            </div>
                        </div>

                        <div class="sidebar-widget">
                            <h2 class="widget-title">Text Widget</h2>
                            <div class="text-widget">
                                <p>
                                    Event Description
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Single Post End-->
    <!-- Back to top button -->
    <a href="#" class="back-to-top"><i class="fa fa-chevron-up"></i></a>

    <script>
        document.getElementById("submitButton").value = "Apply Now";
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const today = new Date();
            const formattedDate = today.toISOString().split("T")[0]; // الحصول على التاريخ بصيغة YYYY-MM-DD
            document.getElementById("AppliedDate").value = formattedDate;
        });
    </script>
</body>
